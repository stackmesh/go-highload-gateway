HTTP_ADDR=:8080
GRPC_ADDR=:9090
# Empty disables pprof. Compose publishes it on :6060 for the local demo.
PPROF_ADDR=
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5432/gateway?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_STREAM=gateway.requests
REDIS_GROUP=audit-workers
UPSTREAM_URL=http://127.0.0.1:8081
UPSTREAM_ADDR=:8081
DEMO_API_KEY=gw_live_demo
LIMITED_API_KEY=gw_live_limited
LOG_LEVEL=info
BODY_LIMIT=1048576
REFRESH_INTERVAL=5s
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN=5s
PUBLISH_BUFFER=8192
STREAM_MAXLEN=100000
SHUTDOWN_TIMEOUT=10s
SWEEP_AFTER=10m
